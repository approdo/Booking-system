{
  "name": "booking-system-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "dev:e2e": "node scripts/e2e-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:deploy": "wrangler deploy --env production --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
