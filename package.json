{
  "name": "booking-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate --preset github_pages",
    "preview": "node scripts/stage-preview.mjs && serve .preview -l 4176",
    "test:unit": "vitest run && npm run test:worker",
    "test:worker": "npm --prefix worker test",
    "test:e2e": "playwright test",
    "test:live": "playwright test -c playwright.live.config.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && npm --prefix worker run typecheck",
    "dev:api": "npm --prefix worker run migrate:local && npm --prefix worker run dev",
    "e2e:api": "npm --prefix worker run dev:e2e",
    "check:worker": "npm --prefix worker run check:deploy",
    "brand-images": "node scripts/generate-brand-images.mjs",
    "psi": "node scripts/psi.mjs",
    "check:site-url": "node scripts/check-site-url.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
